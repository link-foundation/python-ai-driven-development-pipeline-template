+        constraints = temporary_root / "locked-requirements.txt"
+        run(
+            [
+                sys.executable,
+                "-m",
+                "uv",
+                "export",
+                "--locked",
+                "--all-extras",
+                "--no-emit-project",
+                "--no-hashes",
+                "--output-file",
+                str(constraints),
+            ],
+            cwd=project_root,
+        )
         target_python = python_executable(target_venv)
         audit_python = python_executable(audit_venv)
         run(
@@ -90,6 +105,8 @@ def audit_dependencies(project_root: Path) -> None:
