0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/actions/toolkit/issues/comments/4564386179","html_url":"https://github.com/actions/toolkit/issues/2003#issuecomment-4564386179","issue_url":"https://api.github.com/repos/actions/toolkit/issues/2003","id":4564386179,"node_id":"IC_kwDOCt2qZM8AAAABEA8Bgw","user":{"login":"ST-DDT","id":1579362,"node_id":"MDQ6VXNlcjE1NzkzNjI=","avatar_url":"https://avatars.githubusercontent.com/u/1579362?v=4","gravatar_id":"","url":"https://api.github.com/users/ST-DDT","html_url":"https://github.com/ST-DDT","followers_url":"https://api.github.com/users/ST-DDT/followers","following_url":"https://api.github.com/users/ST-DDT/following{/other_user}","gists_url":"https://api.github.com/users/ST-DDT/gists{/gist_id}","starred_url":"https://api.github.com/users/ST-DDT/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ST-DDT/subscriptions","organizations_url":"https://api.github.com/users/ST-DDT/orgs","repos_url":"https://api.github.com/users/ST-DDT/repos","events_url":"https://api.github.com/users/ST-DDT/events{/privacy}","received_events_url":"https://api.github.com/users/ST-DDT/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-28T13:24:24Z","updated_at":"2026-05-28T14:50:49Z","body":"I assume you marked unzip-stream because that is the original source of the issue.\n\nHere the next step upsteam: https://github.com/mhr3/unzip-stream/issues/55\n\n- https://github.com/mhr3/unzip-stream/issues/55\n\nIt looks like `unzip-stream` is no longer maintained: Last commit 2024-04-20\n\n`@Maintainers of actions/toolkit`, would you consider replacing the unmaintained fork with a different or new one?\n\nPossible options are [`@zip-js/zip-js`](https://www.npmjs.com/package/@zip.js/zip.js) (maintained) or [`unzipper`](https://www.npmjs.com/package/unzipper), which seems to have received at least minimal maintenance recently (although no releases), or a new community fork of unzip-stream. Or an entirely different unzip library.\n\nIf you are fine with a replacement, I'll PR the required changes.\n<details>\n<summary>If you would be ok with/prefer a new community fork, I'm willing to start it, if I get at least another reviewer/maintainer.</summary>\n\nSteps:\n\n- Bump to Node 20+\n- Fix deprecation warnings (only)\n- Release First Maintainance Release\n- ...\n- Bump to Node 22+ (current LTS)\n- Modernize tooling\n- Possibly migrate to TypeScript (while remaining API compatible)\n- Possibly migrate to ESM (only)\n\n</details>","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/actions/toolkit/issues/comments/4564386179/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/actions/toolkit/issues/comments/4564748855","html_url":"https://github.com/actions/toolkit/issues/2003#issuecomment-4564748855","issue_url":"https://api.github.com/repos/actions/toolkit/issues/2003","id":4564748855,"node_id":"IC_kwDOCt2qZM8AAAABEBSKNw","user":{"login":"MikeMcC399","id":66998419,"node_id":"MDQ6VXNlcjY2OTk4NDE5","avatar_url":"https://avatars.githubusercontent.com/u/66998419?v=4","gravatar_id":"","url":"https://api.github.com/users/MikeMcC399","html_url":"https://github.com/MikeMcC399","followers_url":"https://api.github.com/users/MikeMcC399/followers","following_url":"https://api.github.com/users/MikeMcC399/following{/other_user}","gists_url":"https://api.github.com/users/MikeMcC399/gists{/gist_id}","starred_url":"https://api.github.com/users/MikeMcC399/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/MikeMcC399/subscriptions","organizations_url":"https://api.github.com/users/MikeMcC399/orgs","repos_url":"https://api.github.com/users/MikeMcC399/repos","events_url":"https://api.github.com/users/MikeMcC399/events{/privacy}","received_events_url":"https://api.github.com/users/MikeMcC399/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-05-28T13:58:58Z","updated_at":"2026-05-28T13:58:58Z","body":"@Samirat \n\nThis issue is more than one year old with so far no response from any maintainer. Would you be able to take a look?","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/actions/toolkit/issues/comments/4564748855/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/actions/toolkit/issues/comments/4720782243","html_url":"https://github.com/actions/toolkit/issues/2003#issuecomment-4720782243","issue_url":"https://api.github.com/repos/actions/toolkit/issues/2003","id":4720782243,"node_id":"IC_kwDOCt2qZM8AAAABGWFrow","user":{"login":"bashonly","id":88596187,"node_id":"MDQ6VXNlcjg4NTk2MTg3","avatar_url":"https://avatars.githubusercontent.com/u/88596187?v=4","gravatar_id":"","url":"https://api.github.com/users/bashonly","html_url":"https://github.com/bashonly","followers_url":"https://api.github.com/users/bashonly/followers","following_url":"https://api.github.com/users/bashonly/following{/other_user}","gists_url":"https://api.github.com/users/bashonly/gists{/gist_id}","starred_url":"https://api.github.com/users/bashonly/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/bashonly/subscriptions","organizations_url":"https://api.github.com/users/bashonly/orgs","repos_url":"https://api.github.com/users/bashonly/repos","events_url":"https://api.github.com/users/bashonly/events{/privacy}","received_events_url":"https://api.github.com/users/bashonly/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-06-16T16:01:56Z","updated_at":"2026-06-16T16:01:56Z","body":"It does seem unacceptable for a critical component of GitHub Actions commonly used in the publishing of release artifacts to be depending on an unmaintained NPM package with a known security vulnerability. ","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/actions/toolkit/issues/comments/4720782243/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/actions/toolkit/issues/comments/6672682500","html_url":"https://github.com/actions/toolkit/issues/2003#issuecomment-6672682500","issue_url":"https://api.github.com/repos/actions/toolkit/issues/2003","id":6672682500,"node_id":"IC_kwDOCt2qZM8AAAABjbkOBA","user":{"login":"konard","id":1431904,"node_id":"MDQ6VXNlcjE0MzE5MDQ=","avatar_url":"https://avatars.githubusercontent.com/u/1431904?v=4","gravatar_id":"","url":"https://api.github.com/users/konard","html_url":"https://github.com/konard","followers_url":"https://api.github.com/users/konard/followers","following_url":"https://api.github.com/users/konard/following{/other_user}","gists_url":"https://api.github.com/users/konard/gists{/gist_id}","starred_url":"https://api.github.com/users/konard/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/konard/subscriptions","organizations_url":"https://api.github.com/users/konard/orgs","repos_url":"https://api.github.com/users/konard/repos","events_url":"https://api.github.com/users/konard/events{/privacy}","received_events_url":"https://api.github.com/users/konard/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-11-05T23:54:18Z","updated_at":"2026-11-05T23:54:18Z","body":"Verified this remains reproducible with `@actions/artifact@6.3.1`, its `unzip-stream@0.3.4` reader, and Node 26.13.0:\n```sh\nnpm install --ignore-scripts @actions/artifact@6.3.1\nnode --pending-deprecation --throw-deprecation -e \"require('unzip-stream').Parse()\"\n```\nThe constructor fails immediately with `DEP0005: Buffer() is deprecated`, at `unzip-stream/lib/unzip-stream.js:47:17`, before any archive is supplied. The 6.3.1 SDK still declares this reader.\n\nOur workaround keeps the official SDK for authentication, transfer and digest verification (`skipDecompress: true`, preserving `expectedHash`), then uses `@zip.js/zip.js@2.24.0` for extraction. The adapter also checks entry paths and CRCs and exercises a real SDK upload/download ZIP round trip under `--pending-deprecation --throw-deprecation`: https://github.com/link-foundation/sensitive-data-sanitizer/pull/103 .\n\nReplacing the SDK's reader with a maintained ZIP64/streaming implementation, or exposing an extraction strategy while keeping the transfer/hash layer, would remove this downstream duplication. A constructor-only `Buffer.from` patch removes this one warning but should not substitute for reviewing the old reader's other compatibility/security properties. This adds current-version evidence to this existing report.\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/actions/toolkit/issues/comments/6672682500/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]
